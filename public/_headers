# Cloudflare Pages _headers — caching + security. Crawlers are NOT blocked.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Framing IS allowed (no X-Frame-Options) so the MCP ext-app can embed the live
  # studio. Low clickjacking risk: the only state-changing action (generate) is
  # spend-capped and costs the owner, not the visitor. frame-ancestors stays open.
  Content-Security-Policy: frame-ancestors *

# R2-served generated skin artifacts — immutable, long cache so Cloudflare's CDN
# absorbs reads and R2 Class-B ops only happen on a cache miss (overage guard).
/api/asset/*
  Cache-Control: public, max-age=31536000, immutable

# Vite emits content-hashed JS/CSS into /assets — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static art (skin frames, sprites, icons) — long cache, content rarely changes.
/skins/*
  Cache-Control: public, max-age=604800
/sprites/*
  Cache-Control: public, max-age=604800
/styles/*
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=604800

# Discoverability files — short cache so edits propagate.
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
