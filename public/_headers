# Cloudflare Pages _headers — caching + security. Crawlers are NOT blocked.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Framing IS allowed (no X-Frame-Options) so the MCP ext-app can embed the live
  # studio. Low clickjacking risk: the only state-changing action (generate) is
  # spend-capped and costs the owner, not the visitor. frame-ancestors stays open.
  Content-Security-Policy: frame-ancestors *

# R2-served generated skin artifacts: the long immutable Cache-Control is set by
# the asset Function ITSELF, on 200 responses only (functions/api/asset/[[path]].ts).
# It is deliberately NOT set here: a blanket _headers rule can't condition on status,
# so it would also cache 404s — and a generated skin's frame.png is briefly 404 while
# the browser uploads it (two-step write, see /api/finalize). Caching that 404 under
# `immutable` would serve a stale 404 forever. The Function gives 200→immutable,
# 404→no-store, which is what we want.

# Vite emits content-hashed JS/CSS into /assets — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static art (skin frames, sprites, icons) — long cache, content rarely changes.
/skins/*
  Cache-Control: public, max-age=604800
/sprites/*
  Cache-Control: public, max-age=604800
/styles/*
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=604800

# Discoverability files — short cache so edits propagate.
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
