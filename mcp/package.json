{
  "name": "skeuo-mcp",
  "version": "1.0.0",
  "author": "Conner K Ward",
  "type": "module",
  "main": "index.ts",
  "description": "An MCP server that turns a sentence into a real, working skeuomorphic music-player skin — a wildly-shaped photoreal device body whose switches flip, knobs turn, and faders slide, generated by the skeuo layout-first pipeline.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "skeuomorphic",
    "music-player",
    "ui-generation",
    "generative-ui",
    "image-generation",
    "claude-skill"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "exports": {
    ".": "./index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
