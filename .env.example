# Spotify Connect mode — register an app at https://developer.spotify.com/dashboard
# then copy this file to `.env.local` and fill in your Client ID.
#
# In the Spotify app settings, add these Redirect URIs (must match EXACTLY,
# including trailing slash rules — Vite serves at the bare origin):
#     http://127.0.0.1:5173/          (local dev — Spotify now requires 127.0.0.1, NOT localhost)
#     https://<your-deploy-host>/     (production)
# Spotify rejects http://localhost as a redirect URI; use 127.0.0.1 in dev.
#
# No client secret is used — this is a public SPA using Authorization Code + PKCE.
VITE_SPOTIFY_CLIENT_ID=
