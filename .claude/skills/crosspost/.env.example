# Crosspost secrets — copy to .env (git-ignored) and fill in.
# Never commit .env. Generate these in each platform's developer dashboard;
# paste them here in your editor (do not echo secrets into the terminal).

# --- Reddit (API) ---
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- Twitter / X (API) ---
# Create an app at https://developer.x.com (Free tier OK, ~500 posts/mo write).
# App must have "Read and write" permission; regenerate Access Token after enabling write.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Hacker News ---
# No API — posting goes through Claude-in-Chrome on your live session.
# No credentials stored here.
